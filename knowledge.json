{
  "birth_certificate": {
    "name": "Birth Certificate",
    "description": "Official birth registration certificate from local registrar",
    "subtypes": {
      "newborn": {
        "documents": ["Application form", "Hospital birth report", "Parent Aadhaar copies", "Parent ID proof", "Marriage certificate"],
        "office": "Local Registrar of Births & Deaths / Village Office (Panchayat)",
        "fee": "Free within 21 days, ₹5-25 after 21 days",
        "timeline": "Same day to 7 days",
        "portal_link": "https://keralaplus.kerala.gov.in/",
        "online_available": true
      },
      "delayed": {
        "documents": ["Application form", "Affidavit", "Newspaper announcement", "School leaving certificate", "Aadhaar copies"],
        "office": "Sub-Registrar Office / District Registrar",
        "fee": "₹50-200 + penalty",
        "timeline": "7-30 days",
        "portal_link": "https://keralaplus.kerala.gov.in/",
        "online_available": true
      }
    },
    "keywords": ["birth certificate", "janma certificate", "child birth", "newborn registration"]
  },
